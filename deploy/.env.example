# Copier en deploy/.env et remplir avant le déploiement

# Domaines publics (les DNS A doivent pointer vers le serveur)
APP_DOMAIN=app.powerwatch.cm
API_DOMAIN=api.powerwatch.cm

# Mot de passe PostgreSQL (choisir une valeur forte)
DB_PASSWORD=change-me-strong-password

# Secret JWT admin : openssl rand -base64 32
JWT_SECRET=change-me-jwt-secret

# Clés VAPID pour les notifications push
# Générer : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
