{
  "name": "powerwatch-cameroun",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "turbo run dev",
    "dev:api": "npm run dev -w @powerwatch/api",
    "dev:web": "npm run dev -w @powerwatch/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "turbo run db:generate",
    "db:push": "npm run db:push -w @powerwatch/api",
    "db:seed": "npm run db:seed -w @powerwatch/api",
    "db:migrate": "turbo run db:migrate",
    "test": "npm run test -w @powerwatch/api"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "prettier": "^3.2.0"
  }
}
